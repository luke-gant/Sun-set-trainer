import requests
import pandas as pd
from datetime import datetime, timedelta

# Coordinates
POINTS = {
    "eugene_valley": {"lat": 44.0521, "lon": -123.0868},
    "eugene_coast_gap": {"lat": 44.0000, "lon": -123.9500}
}

end_date = datetime.now().date()
start_date = end_date - timedelta(days=60)

url = "https://archive-api.open-meteo.com/v1/archive"

hourly_vars = [
    "cloud_cover",
    "cloud_cover_low",
    "cloud_cover_mid",
    "cloud_cover_high",
    "relative_humidity_2m",
    "visibility",
    "precipitation"
]

data_frames = {}

for name, coords in POINTS.items():
    params = {
        "latitude": coords["lat"],
        "longitude": coords["lon"],
        "start_date": str(start_date),
        "end_date": str(end_date),
        "hourly": ",".join(hourly_vars),
        "daily": "sunset",
        "timezone": "America/Los_Angeles"
    }
    res = requests.get(url, params=params).json()
    
    # Parse hourly
    df_hourly = pd.DataFrame(res["hourly"])
    df_hourly["time"] = pd.to_datetime(df_hourly["time"])
    
    # Parse daily sunsets
    df_daily = pd.DataFrame(res["daily"])
    df_daily["sunset"] = pd.to_datetime(df_daily["sunset"])
    
    # Extract weather at the hour closest to (or immediately preceding) sunset
    records = []
    for _, row in df_daily.iterrows():
        sunset_dt = row["sunset"]
        # Find weather at the closest recorded hour
        idx = (df_hourly["time"] - sunset_dt).abs().idxmin()
        weather_row = df_hourly.iloc[idx].to_dict()
        weather_row["date"] = sunset_dt.strftime("%Y-%m-%d")
        weather_row["sunset_time"] = sunset_dt.strftime("%H:%M")
        records.append(weather_row)
        
    df_point = pd.DataFrame(records).drop(columns=["time"])
    # Rename columns with prefix
    df_point = df_point.rename(columns={col: f"{name}_{col}" for col in hourly_vars})
    data_frames[name] = df_point

# Merge valley and coastal corridor features on date
df_merged = pd.merge(data_frames["eugene_valley"], data_frames["eugene_coast_gap"], on="date")
df_merged["score_1_to_10"] = ""  # Column for your manual ground truth

df_merged.to_csv("eugene_historical_sunset_training.csv", index=False)
print("Saved eugene_historical_sunset_training.csv with 60 days of data.")
